# Kakao Map Web(JavaScript) SDK public key.
# This key is delivered to the browser by design; restrict its JavaScript SDK domains in Kakao Developers.
VITE_KAKAO_MAP_JS_KEY=YOUR_KAKAO_JAVASCRIPT_KEY

# Optional local PlugPark AI bridge. Keep this loopback-only for the local Qwen/MCP demo.
VITE_LOCAL_AI_BRIDGE_URL=http://127.0.0.1:3000
