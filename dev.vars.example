# PlugPark local Worker secrets
# Do NOT commit .dev.vars.
BUSAN_PARKING_API_KEY=replace_with_your_decoding_key
EV_CHARGER_API_KEY=replace_with_your_decoding_key

# Optional: parking↔charger spatial-match radius in meters
MATCH_RADIUS_METERS=200

# 부산시설공단_공영주차장 시설 현황 조회 서비스의 "상세기능 요청주소"를 그대로 넣으세요.
# 공개 검색 페이지에는 실제 요청주소가 노출되지 않아 자동 확정할 수 없습니다.
BUSAN_REALTIME_PARKING_API_URL=
